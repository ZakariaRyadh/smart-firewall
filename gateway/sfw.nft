# Smart Firewall ruleset, tested in the gateway VM.
# Load:  sudo nft -f gateway/sfw.nft      Check only:  sudo nft -c -f gateway/sfw.nft
# SSH (22) is closed by default. knockd adds the knocker's IP to the "knocked"
# set after a correct knock; the entry expires after 30 s.
#
# VM-specific: enp1s0 is the management card (kept open so SSH from the host
# never locks out). On the Pi use tailscale0 and the LAN card instead, and test
# with the `at` rollback first (see vault: Pi-Setup-and-Data-Pipeline).

table inet sfw {
    set knocked {
        type ipv4_addr
        flags timeout
        timeout 30s
    }
    chain input {
        type filter hook input priority 0; policy drop;
        iif lo accept
        iifname "enp1s0" accept
        ct state established,related accept
        icmp type echo-request accept
        ip saddr @knocked tcp dport 22 accept
    }
}
